# Copy to deploy/.env on the server. Never commit the populated file.
# A real hostname enables Caddy's automatic HTTPS. For a temporary HTTP-only
# IP demo, use http://SERVER_IP (not recommended for credentials).
SITE_ADDRESS=demo.example.edu

POSTGRES_DB=expertise_insight
POSTGRES_USER=expertise_insight
POSTGRES_PASSWORD=<generate-a-long-random-password>

APP_ENV=pilot
APP_DEBUG=false
APP_CORS_ORIGINS=https://demo.example.edu
FRONTEND_BASE_URL=https://demo.example.edu
JWT_SECRET=<generate-with-python-secrets-token_urlsafe-48>
JWT_ACCESS_TTL_MINUTES=480
PASSWORD_RESET_TTL_MINUTES=30
MAX_DOCUMENT_UPLOAD_BYTES=10485760
MAX_CSV_UPLOAD_BYTES=2097152

SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Expertise Insight <no-reply@example.edu>
SMTP_STARTTLS=true

OPENALEX_MAILTO=<contact-email>
OPENALEX_API_KEY=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

SCIBERT_MODEL=allenai/scibert_scivocab_uncased
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_PUBLICATIONS_PER_SYNC=30

# Start conservatively because each process may load NLP models. Increase only
# after observing memory use during a representative import.
CELERY_WORKER_CONCURRENCY=2
