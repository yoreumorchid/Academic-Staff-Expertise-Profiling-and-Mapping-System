# Environment Configuration
# Copy this file to .env and fill in your values.
# cp .env.example .env   (macOS / Linux)
# Copy-Item .env.example .env   (Windows PowerShell)


# Application

APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173


# Security

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=<your-random-secret-at-least-32-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=10080
PASSWORD_RESET_TTL_MINUTES=30


# Database

DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/expertise_insight


# SMTP (email notifications)

# For Gmail: enable 2FA, then generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-email@gmail.com>
SMTP_PASSWORD=<your-gmail-app-password>
SMTP_FROM=ExpertiseInsight <your-email@gmail.com>
SMTP_STARTTLS=true


# External APIs

ORCID_API_BASE=https://pub.orcid.org/v3.0
OPENALEX_API_BASE=https://api.openalex.org
OPENALEX_MAILTO=<your-email>          # OpenAlex polite pool requires an email
IEEE_XPLORE_API_BASE=https://ieeexploreapi.ieee.org/api/v1/search/articles
IEEE_XPLORE_API_KEY=<your-ieee-api-key>   # Required for UC-15 global benchmarking


# LLM — LangChain / OpenAI-compatible (optional)

# The mapping report summary (AI explanation of top-3 matches) is optional.
# If left unconfigured, the system degrades gracefully — reports are generated
# without an AI-written summary paragraph.
LLM_PROVIDER=openai
OPENAI_API_KEY=<your-api-key>
OPENAI_API_BASE=                        # Leave empty for official OpenAI;
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1


# NLP / Embedding Models

SCIBERT_MODEL=allenai/scibert_scivocab_uncased
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# Harvest Limits

MAX_PUBLICATIONS_PER_SYNC=30


# Frontend

FRONTEND_BASE_URL=http://localhost:5173