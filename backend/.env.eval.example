# Evaluation LLM Provider Keys
# Copy this file to .env.eval and fill in your keys.
#   cp .env.eval.example .env.eval          (macOS / Linux)
#   Copy-Item .env.eval.example .env.eval   (Windows PowerShell)
#
# This file is ONLY read by evaluation/scripts/eval_llm.py.
# It does NOT touch your production .env or any production code.
# The script skips any provider whose key is left empty — you only
# need to fill in the ones you actually have API access to.

# OpenAI (required for gpt4o-mini / gpt-4o-mini)
OPENAI_API_KEY=<your-openai-api-key>

# DeepSeek — sign up at https://platform.deepseek.com
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Gemini 2.0 Flash — sign up at https://aistudio.google.com
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# Custom OpenAI-compatible provider (optional)
# EVAL_LLM_API_KEY=<your-custom-api-key>
# EVAL_LLM_API_BASE=<your-custom-api-base-url>
# EVAL_LLM_MODEL=<your-custom-model-name>